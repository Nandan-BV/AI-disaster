# Project
PROJECT_NAME=RESQ-AI
VERSION=0.1.0
ENVIRONMENT=development

# API
API_V1_PREFIX=/api/v1

# Database (PostgreSQL with PostGIS)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=your_password_here
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
DATABASE_NAME=resq_ai

# External disaster data ingestion
EXTERNAL_INGESTION_ENABLED=true
EXTERNAL_INGESTION_INTERVAL_MINUTES=15
USGS_SIGNIFICANT_FEED_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/significant_day.geojson
GDACS_FEED_URL=https://www.gdacs.org/xml/rss.xml
# Optional: enables current conditions and severe alerts for active incident locations.
OPENWEATHERMAP_API_KEY=
OPENWEATHERMAP_API_URL=https://api.openweathermap.org/data/3.0/onecall

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# AI Configuration (Phase 2)
# Model - Use smaller models for limited hardware
# Options: Qwen/Qwen2.5-VL-3B-Instruct, Qwen/Qwen2.5-VL-7B-Instruct, Qwen/Qwen2-VL-2B-Instruct
AI_MODEL_NAME=Qwen/Qwen2.5-VL-3B-Instruct
AI_MODEL_REVISION=main
AI_DEVICE=auto
AI_DTYPE=auto
# AI_MAX_MEMORY=8GiB
# AI_OFFLOAD_FOLDER=./model_offload

# Inference
AI_MAX_NEW_TOKENS=1024
AI_TEMPERATURE=0.1
AI_TOP_P=0.9
AI_DO_SAMPLE=false

# Video
VIDEO_FRAME_INTERVAL=5
VIDEO_MAX_FRAMES=20

# Images
MAX_IMAGE_SIZE=1024

# Timeouts
AI_INFERENCE_TIMEOUT=300
MODEL_LOAD_TIMEOUT=120

# Cache
# HF_CACHE_DIR=./hf_cache

# Embedding Model (Phase 3)
# Options: BAAI/bge-small-en-v1.5, sentence-transformers/all-MiniLM-L6-v2, sentence-transformers/all-mpnet-base-v2
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=auto
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_LENGTH=512

# Clustering Configuration (Phase 3)
SEMANTIC_SIMILARITY_THRESHOLD=0.75
MAX_DISTANCE_METERS=2000
MAX_TIME_DIFFERENCE_MINUTES=120
RELATIONSHIP_SCORE_THRESHOLD=0.65

# Relationship Score Weights (must sum to 1.0)
SEMANTIC_WEIGHT=0.40
GEOGRAPHIC_WEIGHT=0.30
TEMPORAL_WEIGHT=0.20
DISASTER_TYPE_WEIGHT=0.10

# Geospatial Configuration (Phase 5)
DEFAULT_INCIDENT_RADIUS_METERS=1000
MAX_INFRASTRUCTURE_RADIUS_METERS=5000

# Resource Configuration (Phase 7)
DEFAULT_RESOURCE_SEARCH_RADIUS_METERS=2000
MAX_RESOURCE_SEARCH_RADIUS_METERS=10000

# Optimization Configuration (Phase 8)
MAX_RESOURCE_ALLOCATION_DISTANCE_METERS=50000

# Optimization Weights
OPT_WEIGHT_DISTANCE=0.3
OPT_WEIGHT_SUITABILITY=0.4
OPT_WEIGHT_UNMET_DEMAND=0.2
OPT_WEIGHT_PRIORITY=0.1

# Solver Configuration
OPT_SOLVER_TIME_LIMIT_SECONDS=30
# Risk Component Weights (must sum to 1.0)
RISK_WEIGHT_SEVERITY=0.25
RISK_WEIGHT_EVIDENCE=0.20
RISK_WEIGHT_POPULATION=0.25
RISK_WEIGHT_INFRASTRUCTURE=0.15
RISK_WEIGHT_ENVIRONMENT=0.10
RISK_WEIGHT_ACCESSIBILITY=0.05

# Risk Level Thresholds (0-100 scale)
RISK_LEVEL_LOW_MAX=19
RISK_LEVEL_MODERATE_MAX=39
RISK_LEVEL_ELEVATED_MAX=59
RISK_LEVEL_HIGH_MAX=79
# 80-100 = critical

# Infrastructure Criticality Weights
INFRA_WEIGHT_HOSPITAL=10.0
INFRA_WEIGHT_SHELTER=8.0
INFRA_WEIGHT_FIRE_STATION=6.0
INFRA_WEIGHT_POLICE_STATION=5.0
INFRA_WEIGHT_BRIDGE=7.0
INFRA_WEIGHT_ROAD=3.0
INFRA_WEIGHT_EMERGENCY_CENTER=8.0
INFRA_WEIGHT_POWER_STATION=6.0
INFRA_WEIGHT_WATER_FACILITY=6.0
INFRA_WEIGHT_SCHOOL=4.0

# Command Center Dashboard (Phase 10)
# Periodic polling interval for the dashboard. This is periodic refresh, not a
# live feed — the backend has no push channel.
DASHBOARD_REFRESH_INTERVAL_SECONDS=30
DASHBOARD_DEFAULT_PAGE_SIZE=20
DASHBOARD_MAX_PAGE_SIZE=100

# Copilot Configuration (Phase 9)

# LLM provider. The serving stack is swappable, so this is selected by name:
#   openai_compatible - any OpenAI-compatible server (vLLM, Ollama, llama.cpp, TGI).
#                       Recommended default; run the model out of process.
#   transformers      - in-process HF generation. Development only; the API
#                       event loop is blocked while the model generates.
#   mock              - deterministic stub, used by the test suite.
COPILOT_PROVIDER=openai_compatible
COPILOT_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct
COPILOT_MODEL_REVISION=main

# Only used by COPILOT_PROVIDER=openai_compatible.
# vLLM:  http://localhost:8000/v1
# Ollama: http://localhost:11434/v1
COPILOT_API_BASE_URL=http://localhost:8000/v1
# Leave empty for a local server with no auth. Set for a hosted endpoint.
# COPILOT_API_KEY=

# Only used by COPILOT_PROVIDER=transformers.
COPILOT_DEVICE=auto
COPILOT_DTYPE=auto
# COPILOT_MAX_MEMORY=8GiB
# COPILOT_OFFLOAD_FOLDER=./model_offload

COPILOT_MAX_TOKENS=2048
COPILOT_TEMPERATURE=0.1
COPILOT_TOP_P=0.9
COPILOT_DO_SAMPLE=false
COPILOT_MAX_HISTORY_MESSAGES=20
COPILOT_MAX_HISTORY_TOKENS=8192
COPILOT_TIMEOUT_SECONDS=120

# Controlled actions are off by default. Even when enabled, the copilot has no
# approve, dispatch, or record-mutation tool: an operator always decides.
COPILOT_ALLOW_CONTROLLED_ACTIONS=false